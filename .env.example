# --- Sale-U ReportePowerBI (POST jsnInfo) — equivalencia con la doc ---
# Authorization: key=Token        → SELLU_AUTH_KEY=<Token real; lo que va después de "key=">
# infoAuthApp.sSecretTokenApp     → SELLU_SECRET_TOKEN_APP=<SecretToken real>
# infoJSON.AgMarcaGrupo           → SELLU_AG_MARCA_GRUPO
# infoJSON.fechaInicio / fechaFinal → SELLU_FECHA_INICIO / SELLU_FECHA_FIN
# tipoReporte (leads | actividades) lo pone el código en cada POST; no va en .env

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Modo recomendado: reportes Sell-U (POST application/x-www-form-urlencoded) ---
# Misma URL para leads y actividades; cambia solo infoJSON.tipoReporte en el cuerpo.
SELLU_REPORT_POST_URL=https://api.sale-u.com/v1/JSRS/ReportePowerBI.php

# Token del header: Authorization: key=<valor>  (equivale a "key=Token" en la doc)
SELLU_AUTH_KEY=

# O la cabecera Authorization completa (tiene prioridad sobre SELLU_AUTH_KEY)
# SELLU_AUTHORIZATION=key=tu_token_aqui

# Cuerpo JSON embebido en el campo form "jsnInfo"
SELLU_SECRET_TOKEN_APP=
SELLU_AG_MARCA_GRUPO=MG
SELLU_FECHA_INICIO=2026-03-01 00:00:00
SELLU_FECHA_FIN=2026-12-31 00:00:00

# true = solo POST tipoReporte leads (omitir actividades)
# SELLU_SKIP_ACTIVITIES=false

# --- Modos alternativos (sin POST jsnInfo) ---
# SELLU_SYNC_URL=
# SELLU_LEADS_URL=
# SELLU_ACTIVITIES_URL=
# SELLU_HTTP_METHOD=GET
# SELLU_API_TOKEN=   # legado: Authorization: Bearer … en GET

# JSON opcional: cabeceras extra (se fusionan; pueden sobrescribir Authorization si lo pones ahí)
# SELLU_EXTRA_HEADERS_JSON=

# Opcional: protege la Edge Function (cron): Bearer o x-cron-secret
# CRON_SECRET=

# Prueba local scripts/sellu-dry-run.mjs: jsnInfo sin enmascarar (cuidado en logs)
# SELLU_DRY_RUN_LOG_BODY=full
