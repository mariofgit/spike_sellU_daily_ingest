# =============================================================================
# Sell-U ReportePowerBI (POST application/x-www-form-urlencoded, body jsnInfo=<JSON>)
# =============================================================================
# Authorization: key=<token>           → SELLU_AUTH_KEY=<token without "key=">
# infoAuthApp.sSecretTokenApp           → SELLU_SECRET_TOKEN_APP
# infoJSON.AgMarcaGrupo               → SELLU_BRAND_GROUP (maps onto AgMarcaGrupo JSON field)
#
# Sell-U tipoReporte (leads | actividades) — literal API values; picked per request by code.
#
# When SELLU_SYNC_STATE_ENABLED=true the code fills fechaInicio/fechaFinal for each calendar day.
# Otherwise set legacy window aliases below (still mapped onto fechaInicio/fechaFinal in JSON).

# =============================================================================
# Supabase
# =============================================================================
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_DB_SCHEMA=raw
SUPABASE_TABLE_LEADS=raw_leads
SUPABASE_TABLE_LEADS_ACTIVITY=raw_lead_activities

# Edge: `supabase secrets set` rejects custom SUPABASE_* secret names → deploy maps SUPABASE_* → INGEST_*.
# You can omit INGEST_* for local ingest only; for Edge, `npm run deploy:edge:sellu` reads this .env and uploads INGEST_*.

# staging → import_batch_id, aglead, raw_payload (MG landing tables)
# normalized → uuid FK model + upserts against reference migration tables
SUPABASE_INGEST_MODEL=staging

# SUPABASE_IMPORT_BATCH_ID=
#
# Staging FK: upsert parent row before staging inserts (migrations: *_import_batches.sql)
# SUPABASE_IMPORT_BATCHES_TABLE=import_batches
# SUPABASE_IMPORT_BATCHES_SCHEMA=ingest
# Same UUID to each column (must match pg_get_constraintdef on raw.raw_leads, often id).
# SUPABASE_IMPORT_BATCH_ID_COLUMNS=id
# SUPABASE_IMPORT_BATCH_ON_CONFLICT=id
# SUPABASE_IMPORT_BATCH_ROW_JSON={"source":"sellu_sync"}
# SELLU_UPSERT_BATCH_SIZE=500

# =============================================================================
# Daily sync cursor → raw.sellu_sync_state (one TZ calendar day per cron run until caught up with “yesterday”)
# Migration: supabase/migrations/20250508120000_sellu_sync_state.sql
# =============================================================================
# SELLU_SYNC_STATE_ENABLED=true
# SELLU_SYNC_TIMEZONE=America/Bogota
# SELLU_SYNC_FIRST_LOCAL_DATE=2026-01-01
# Default empty SELLU_SYNC_ADVANCE_ON_EMPTY → keeps advancing when Sell-U yields zero rows
# SELLU_SYNC_ADVANCE_ON_EMPTY=false
# SUPABASE_SYNC_STATE_TABLE=sellu_sync_state
# SUPABASE_SYNC_STATE_ID=default

# =============================================================================
# Sell-U POST (recommended integration path)
# =============================================================================
SELLU_REPORT_POST_URL=https://api.sale-u.com/v1/JSRS/ReportePowerBI.php

SELLU_AUTH_KEY=

# SELLU_AUTHORIZATION=key=<full Authorization header payload>

SELLU_SECRET_TOKEN_APP=
SELLU_BRAND_GROUP=MG

# Legacy window mirrored into fechaInicio / fechaFinal when sync-state mode is OFF
SELLU_LEGACY_REPORT_START=2026-03-01 00:00:00
SELLU_LEGACY_REPORT_END=2026-12-31 00:00:00

# true → only request Sell-U report type "leads"
# SELLU_SKIP_ACTIVITIES=false

# SELLU_EXTRA_HEADERS_JSON=

# =============================================================================
# Alternate GET-style modes (omit when using POST jsnInfo)
# =============================================================================
# SELLU_SYNC_URL=
# SELLU_LEADS_URL=
# SELLU_ACTIVITIES_URL=
# SELLU_HTTP_METHOD=GET
# SELLU_API_TOKEN=

# Edge Function bearer / header secret for scheduled invokes
# CRON_SECRET=
